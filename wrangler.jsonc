{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uninvited-painter",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/r/*", "/a/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }]
  },
  "workflows": [{
    "name": "uninvited-painter-post-round-ai",
    "binding": "POST_ROUND_AI",
    "class_name": "PostRoundAiWorkflow"
  }],
  "r2_buckets": [{
    "binding": "ARTWORK",
    "bucket_name": "uninvited-painter-artwork"
  }],
  "ratelimits": [{
    "name": "AI_RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 10, "period": 60 }
  }],
  "kv_namespaces": [{ "binding": "ARCHIVES", "id": "efd1a54f0f394b0f9d4295eaf66b9962" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  "routes": [{ "pattern": "painter.amazingvince.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
